# ==========================================
# OmniDesk AI - Environment Configuration
# ==========================================

# Application Metadata
APP_NAME="OmniDesk AI - Autonomous IT Copilot"
APP_ENV=development

# OpenAI API (LLM Orchestration & Embeddings)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (Chroma DB)
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=compny_data_kb

# External Web Search Fallback (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# RAG & Retrieval Tuning
TOP_K=4
MAX_RETRIES=1

# Security & Admin Access (Required for document ingestion endpoints)
ADMIN_API_KEY=change-me-in-production
